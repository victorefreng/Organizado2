node_modules/
# dist/ ya NO se ignora: los vídeos renderizados tienen que sobrevivir al
# contenedor, y subirlos al repositorio es la única vía.
dist/**/.frames-*/
dist/render.log
.DS_Store
*.log
/public/assets/memories/*.png
/public/assets/memories/*.jpg
!/public/assets/memories/.gitkeep
/captures/

# Vídeos exportados (se generan con npm run export)
exports/
exports-test/

# Paquetes publicados (se regeneran con npm run produce)
public/packages/
production/*/out/
production/*/source/_standin-*

# Material renderizado de las piezas (se regenera con las herramientas)
production/pieces/*/_raw-*.mp4
production/pieces/*/_loop-*.mp4
production/pieces/*/.frames-*/
# dist/ ya NO se ignora: los vídeos renderizados tienen que sobrevivir al
# contenedor, y subirlos al repositorio es la única vía.
dist/**/.frames-*/
dist/render.log

# El material de stock SÍ va al repositorio: es la única vía para que llegue
# desde la máquina del operador hasta aquí.

# Fotogramas intermedios de los renders de assets
production/assets/*/.frames-*/

# Remotion
remotion/node_modules/
remotion/out/
remotion/public/*.mp4
remotion/.remotion/
