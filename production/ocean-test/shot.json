{
  "id": "ocean-test",
  "name": "OCEAN TEST",
  "chapter": "prueba de flujo",
  "note": "Primera validación del flujo Runway → paquete audiovisual de tres proyectores.",

  "format": {
    "width": 1280,
    "height": 720,
    "fps": 30,
    "duration": 10.0,
    "videoCodec": "libx264",
    "crf": 18,
    "pixelFormat": "yuv420p",
    "audioSampleRate": 48000,
    "audioChannels": 2,
    "audioBitDepth": 16
  },

  "//main": "MAIN = el clip de Runway. Mientras no exista, se usa standIn (render del motor) para validar el flujo sin gastar créditos.",
  "main": {
    "source": "source/whale-runway.mp4",
    "standIn": "source/_standin-whale.mp4",
    "fit": "cover",
    "grade": {
      "contrast": 1.06,
      "brightness": -0.012,
      "saturation": 1.04,
      "gamma": 0.98,
      "temperature": -6,
      "vignette": 0.26,
      "grain": 2.5
    },
    "//standInPlate": "Mientras no exista el clip de Runway, esta plancha del motor hace de MAIN para validar el flujo de punta a punta sin gastar créditos. NO es el entregable final.",
    "standInPlate": {
      "world": "ocean",
      "variant": "deep",
      "params": { "whales": "force", "whaleOffset": 0, "whaleDepth": -5, "fishDensity": 0.5, "luminosity": 1.25, "speed": 0.8 },
      "camera": { "position": [-16, -2, 16], "target": [6, -2, -8], "fov": 46 },
      "drift": { "amp": 1.2, "speed": 0.05, "targetAmp": 1.8 },
      "timeOffset": 19.33
    },
    "motion": {
      "//": "Respiración 2.5D: un empuje lentísimo que evita que el clip se note congelado en los extremos.",
      "zoomFrom": 1.0,
      "zoomTo": 1.045,
      "panX": 0.0,
      "panY": -0.006
    }
  },

  "//plates": "CEILING y ENVIRONMENT NO son copias del MAIN. Son planchas propias renderizadas con el motor que ya existe, graduadas para casar en color y luz con el MAIN. La relación entre pantallas es tonal y rítmica, no geométrica.",
  "plates": {
    "ceiling": {
      "role": "P1 · vista del océano desde abajo, hacia la superficie",
      "world": "ocean",
      "variant": "deep",
      "params": { "whales": false, "fishDensity": 0.3, "luminosity": 1.8, "speed": 0.7 },
      "camera": { "position": [0, 5, 12], "target": [1, 23, -10], "fov": 74 },
      "drift": { "amp": 1.6, "speed": 0.045, "targetAmp": 2.4 },
      "timeOffset": 120.0,
      "grade": { "contrast": 1.04, "brightness": 0.01, "saturation": 0.96, "vignette": 0.34, "grain": 2.0 }
    },
    "environment": {
      "role": "P2 · ambiente acuático con peces y partículas",
      "world": "ocean",
      "variant": "deep",
      "params": { "whales": false, "fishDensity": 1.0, "luminosity": 1.1, "speed": 1.0, "depth": 1 },
      "camera": { "position": [-9, -3, 15], "target": [3, -3, -6], "fov": 52 },
      "drift": { "amp": 2.2, "speed": 0.06, "targetAmp": 3.0 },
      "timeOffset": 215.0,
      "grade": { "contrast": 1.03, "brightness": 0.0, "saturation": 1.0, "vignette": 0.3, "grain": 2.2 }
    }
  },

  "//cues": "Tres momentos musicales. timecode en hh:mm:ss:ff a 30 fps, no drop frame.",
  "cues": [
    {
      "number": 1,
      "timecode": "00:00:01:15",
      "seconds": 1.5,
      "name": "APPROACH",
      "musical": "Entra el sub y el pad abre. Se intuye la masa antes de verla.",
      "light": { "cue": "OCEAN_DEEP", "color": "#063D56", "intensity": 0.28, "fade": 2.5, "group": "all" }
    },
    {
      "number": 2,
      "timecode": "00:00:04:20",
      "seconds": 4.6667,
      "name": "WHALE PASS",
      "musical": "Canto de ballena y floración de brillos. Punto álgido del plano.",
      "light": { "cue": "CAUSTIC_SWEEP", "color": "#7FE3FF", "intensity": 0.42, "fade": 1.2, "group": "hue", "sweep": true }
    },
    {
      "number": 3,
      "timecode": "00:00:07:25",
      "seconds": 7.8333,
      "name": "RELEASE",
      "musical": "La música resuelve hacia abajo. Cola de brillos, el sub se retira.",
      "light": { "cue": "OCEAN_SETTLE", "color": "#021E2E", "intensity": 0.16, "fade": 3.0, "group": "all" }
    }
  ],

  "audio": {
    "master": "out/ocean-test-master.wav",
    "ltc": "out/ocean-test-ltc.wav",
    "startTimecode": "00:00:00:00",
    "layers": ["sub", "pad", "water", "whale", "shimmer"],
    "peakTarget": -1.0,
    "//ltc": "LTC SMPTE 30 fps no-drop en canal mono para que grandMA2 enganche el timecode por entrada de audio."
  },

  "deliverables": {
    "main": "out/ocean-test-MAIN.mp4",
    "ceiling": "out/ocean-test-CEILING.mp4",
    "environment": "out/ocean-test-ENVIRONMENT.mp4",
    "triptych": "out/ocean-test-TRIPTICO.mp4",
    "masterAudio": "out/ocean-test-master.wav",
    "ltc": "out/ocean-test-ltc.wav",
    "cuesCsv": "out/ocean-test-cues.csv",
    "cuesJson": "out/ocean-test-cues.json",
    "cuesMa2": "out/ocean-test-cues-ma2.xml"
  }
}
